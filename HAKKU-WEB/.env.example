# ==========================================
# HAKKU - Digital Legal Companion Environment
# Salin file ini menjadi .env.local untuk development lokal
# JANGAN PERNAH COMMIT FILE .env.local ATAU SECRET NYATA KE GIT
# ==========================================

# Port & URL Aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Mode Lingkungan (local | staging | production)
NODE_ENV=development

# Database (PostgreSQL) - Diperlukan untuk persistensi kasus
# Format: postgresql://username:password@localhost:5432/hakku_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hakku_db

# AI Provider Configuration (Server-Side Only - Jangan gunakan prefix NEXT_PUBLIC_)
# Provider yang didukung: mock | gemini | openai
LLM_PROVIDER=mock
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=gemini-2.0-flash

# Auth Secret (Digunakan untuk session token di server)
AUTH_SECRET=your_random_32_character_secret_here

# Storage Bucket (Private - opsional pada fase MVP)
PRIVATE_STORAGE_BUCKET=hakku-case-documents
